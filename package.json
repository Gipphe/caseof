{
	"name": "caseof",
	"description": "Elm and Haskell-inspired case-of",
	"keywords": [
		"pattern-matching",
		"pattern",
		"matching",
		"case",
		"expression",
		"case-expression",
		"case-of"
	],
	"version": "6.0.0",
	"license": "MIT",
	"author": "Victor Nascimento Bakke",
	"homepage": "https://github.com/Gipphe/caseof",
	"repository": {
		"type": "git",
		"url": "https://github.com/Gipphe/caseof.git"
	},
	"files": [
		"dist/*"
	],
	"module": "dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist/* && tsc",
		"docs": "transcribe --url 'https://github.com/Gipphe/caseof/blob/master/{filename}#L{line}' --insert-into README.md -- src/index.ts",
		"lint": "eslint --ext ts,js src test",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"test": "jest",
		"test:coverage": "jest --ci --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tsconfig/node24": "^24.0.4",
		"@tsconfig/recommended": "^1.0.13",
		"@tsconfig/strictest": "^2.0.8",
		"@types/jest": "^30.0.0",
		"eslint": "^10.8.0",
		"globals": "^17.8.0",
		"jest": "^30.4.2",
		"nyc": "^18.0.0",
		"prettier": "^3.9.6",
		"transcribe": "^1.1.2",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.65.0"
	}
}
